---
###############################################################################
# for dnscrypt-proxy role                                                     #
###############################################################################
enable_dnscrypt_proxy:             false

###############################################################################
# for all roles doing actions for user                                        #
###############################################################################
username:                          "{{ ansible_user_id }}"
userhome:                          "{{ ansible_user_dir }}"

###############################################################################
# SECURITY WARNING: Setting these to true reduces system security.            #
# Only enable in trusted, single-user environments.                            #
###############################################################################
enable_passwordless_sudo:          true
enable_auto_login:                 false
