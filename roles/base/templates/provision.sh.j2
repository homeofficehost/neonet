#!/bin/bash
set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

BRANCH="{{ branch | default('master') }}"
LOGFILE="${HOME}/ansible_provision.log"
REPO="{{ upstream | default('https://github.com/homeofficehost/neonet') }}"

COMMON_OPTS=(--url "$REPO" --checkout "$BRANCH" --clean)

# Ensure the log file exists so we can append to it
: >> "$LOGFILE"

# Overlap guard: refuse to run while another ansible-pull is in progress
if pgrep -u "$(id -u)" -f ansible-pull > /dev/null; then
  printf "\n%s A running ansible-pull process was found.\nExiting.\n" "$(date +"%Y-%m-%d %H:%M:%S")" | tee -a "$LOGFILE"
  exit 1
fi

START_TIME=$(date +%s)
printf "\n%s provision start\n" "$(date +"%Y-%m-%d %H:%M:%S")" | tee -a "$LOGFILE"

if [[ -n ${1:-} ]]; then
  ansible-pull -i localhost, --tags "$1" "${COMMON_OPTS[@]}" 2>&1 | tee -a "$LOGFILE"
  RC=${PIPESTATUS[0]}
else
  ansible-pull -i localhost, "${COMMON_OPTS[@]}" 2>&1 | tee -a "$LOGFILE"
  RC=${PIPESTATUS[0]}
fi

END_TIME=$(date +%s)
ELAPSED=$(( END_TIME - START_TIME ))
MINUTES=$(( ELAPSED / 60 ))
SECONDS=$(( ELAPSED % 60 ))

printf "%s provision finish: %dm %ds, exit code %d\n" "$(date +"%Y-%m-%d %H:%M:%S")" "$MINUTES" "$SECONDS" "$RC" | tee -a "$LOGFILE"

# Desktop notification (osascript no macOS, notify-send no Linux)
if [ "$RC" -eq 0 ]; then
  TITLE="🚀 Dotfiles Provisioned!"; MSG="Completed in ${MINUTES}m ${SECONDS}s — all roles applied"
else
  TITLE="❌ Provisioning Failed"; MSG="Exit code ${RC} — check ansible_provision.log"
fi
if command -v osascript >/dev/null; then
  osascript -e "display notification \"$MSG\" with title \"$TITLE\"" 2>/dev/null || true
elif command -v notify-send >/dev/null; then
  notify-send "$TITLE" "$MSG" 2>/dev/null || true
fi

exit "$RC"
